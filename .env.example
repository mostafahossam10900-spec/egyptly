# Egyptly environment variables — names only. Copy to .env.local and fill in.
# For local development run `npm run env:local` instead (reads the local Supabase stack).
# If these are missing the app runs in clearly labelled DEMO MODE (no accounts, no saving).

# Supabase project URL (browser-safe)
VITE_SUPABASE_URL=
# Supabase anon / publishable key (browser-safe; access is limited by Row Level Security)
VITE_SUPABASE_ANON_KEY=
# Public site URL used in email links (defaults to the current origin)
VITE_SITE_URL=

# --- Server-side only (never prefix with VITE_, never commit) ---
# Needed only by tooling/tests against a hosted project, not by the browser app.
SUPABASE_SERVICE_ROLE_KEY=
# Production email delivery (Supabase Auth custom SMTP), configured in the Supabase dashboard / config.toml:
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
